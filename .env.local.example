# Supabaseプロジェクトの設定 (Project Settings > API から取得)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API (買い物リスト最適化エージェント用)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 開発環境専用: /api/dev-login でテストアカウントに自動ログインするための
# 認証情報(本番ビルドでは自動的に無効化されるため、本番環境変数には設定不要)
DEV_TEST_LOGIN_EMAIL=recipe-app-testagent@mailinator.com
DEV_TEST_LOGIN_PASSWORD=your-test-account-password
